# BlsunTech V2 production environment template
# Copy to .env.production on AWS and replace placeholders.

DJANGO_PRODUCTION=true
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_PRODUCTION_DOMAIN
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_PRODUCTION_DOMAIN

POSTGRES_DB=blsuntech_v2
POSTGRES_USER=blsuntech_v2
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
